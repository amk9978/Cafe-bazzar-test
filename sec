import json
import logging
import sys
from abc import ABC, abstractmethod
from collections import defaultdict
from contextlib import redirect_stdout

logger = logging.getLogger("Cafe")


class City:
    def __init__(self, id: int, name: str):
        self.id = id
        self.name = name

    @classmethod
    def from_user_input(cls):
        id = int(input("id=?\n"))
        name = input("name=?\n")
        return cls(id=id, name=name)


class Road:
    def __init__(
        self,
        id: int,
        name: str,
        from_: int,
        to: int,
        through: [int],
        speed_limit: int,
        length: int,
        bi_directional: int,
    ):
        self.id = id
        self.name = name
        self.from_ = from_
        self.to = to
        self.through = through
        self.speed_limit = speed_limit
        self.length = length
        self.bi_directional = bi_directional

    @classmethod
    def from_user_input(cls):
        id = int(input("id=?\n"))
        name = input("name=?\n")
        from_ = int(input("from=?\n"))
        to = int(input("to=?\n"))
        through: [int] = json.loads(input("through=?\n"))
        speed_limit = int(input("speed_limit=?\n"))
        length = int(input("length=?\n"))
        bi_directional = int(input("bi_directional=?\n"))
        return cls(
            id=id,
            name=name,
            from_=from_,
            to=to,
            through=through,
            speed_limit=speed_limit,
            length=length,
            bi_directional=bi_directional,
        )


cities = {}
roads = {}
road_to_city = defaultdict(set)
city_to_road = defaultdict(set)


class CommandStrategy(ABC):
    @abstractmethod
    def execute(self):
        pass


class HelpStrategy(CommandStrategy):
    def execute(self):
        print("Select a number from shown menu and enter. For example 1 is for help.")


def add_city() -> City:
    city = City.from_user_input()
    cities[city.id] = city
    return city


def add_road() -> Road:
    road = Road.from_user_input()
    roads[road.id] = road

    cities_set = {road.from_}
    cities_set.update(road.through)
    cities_set.add(road.to)
    road_to_city[road.id] = cities_set

    city_to_road[road.from_].add(road.id)
    for city_id in road.through:
        city_to_road[city_id].add(road.id)

    city_to_road[road.to].add(road.id)
    return road


class AddStrategy(CommandStrategy):
    def execute(self):
        choice = input("Select model:\n1. City\n2. Road\n")
        obj = None
        if choice == "1":
            city = add_city()
            obj = city
        elif choice == "2":
            road = add_road()
            obj = road
        print("{} with id={} added!".format(type(obj).__name__, obj.id))
        while True:
            choice = input(
                "Select your next action:\n1. Add another {}\n2. Main Menu\n".format(
                    type(obj).__name__
                )
            )
            if choice == "1":
                if isinstance(obj, City):
                    add_city()
                elif isinstance(obj, Road):
                    add_road()
            else:
                break


class DeleteStrategy(CommandStrategy):
    def execute(self):
        choice_map = {"1": "City", "2": "Road"}
        choice = input("Select model:\n1. City\n2. Road\n")
        id = int(input())
        obj = None
        if choice == "1":
            obj = cities.pop(id, None)
            city_roads = city_to_road.pop(id, None)
            if city_roads is not None:
                for road in city_roads:
                    road_to_city[road].remove(id)
        elif choice == "2":
            obj = roads.pop(id, None)
            road_cities = road_to_city.pop(id, None)
            if road_cities is not None:
                for city in road_cities:
                    city_to_road[city].remove(id)

        if obj is None:
            print("{} with id {} not found!".format(choice_map[choice], id))
        else:
            print("{}:{} deleted!".format(choice_map[choice], id))


def format_time(time: float) -> str:
    total_minutes = int(time * 60)
    days = total_minutes // (60 * 24)
    hours = (total_minutes // 60) % 24
    minutes = total_minutes % 60

    return f"{days:02d}:{hours:02d}:{minutes:02d}"


def path_finder(origin: int, dest: int) -> dict:
    result = {}
    origin_roads = city_to_road[origin]
    for road_id in origin_roads:
        road = roads[road_id]
        if road.bi_directional == 1:
            if road.id in city_to_road[dest]:
                time = road.length / road.speed_limit
                result[road] = time
        else:
            if road.id in city_to_road[dest]:
                for city in road_to_city[road.id]:
                    if city == origin:
                        time = road.length / road.speed_limit
                        result[road] = time
                        break
                    elif city == dest:
                        break

    return {k: v for k, v in sorted(result.items(), key=lambda entry: entry[1])}


class PathStrategy(CommandStrategy):
    def execute(self):
        path = input()
        origin = int(path.split(":")[0])
        dest = int(path.split(":")[1])
        paths: dict = path_finder(origin=origin, dest=dest)
        for path, time in paths.items():
            formatted_time = format_time(time=time)
            print(
                "{}:{} via Road {}: Takes {}".format(
                    cities[origin].name, cities[dest].name, path.name, formatted_time
                )
            )


class ExitStrategy(CommandStrategy):
    def execute(self):
        sys.exit()


class CommandContext:
    @property
    def strategy(self):
        return self._strategy

    @strategy.setter
    def strategy(self, strategy: CommandStrategy):
        self._strategy = strategy

    def execute_command(self):
        self._strategy.execute()


def main():
    command_mapping = {
        "1": "Help",
        "2": "Add",
        "3": "Delete",
        "4": "Path",
        "5": "Exit",
    }
    strategy_mapping = {
        "1": HelpStrategy(),
        "2": AddStrategy(),
        "3": DeleteStrategy(),
        "4": PathStrategy(),
        "5": ExitStrategy(),
    }

    context = CommandContext()
    input_template = "Main Menu - Select an action:"
    for key, val in command_mapping.items():
        input_template += "\n{}. {}".format(key, val)
    input_template += "\n"
    while True:
        choice = input(input_template)
        if choice in strategy_mapping:
            strategy = strategy_mapping[choice]
            context.strategy = strategy
            context.execute_command()
        else:
            print("Invalid input. Please enter 1 for more info.")


if __name__ == "__main__":
    main()
